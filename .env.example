# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Public-facing base URL (used inside email links: verify, reset, etc.)
APP_BASE_URL=http://localhost:3000

# Comma-separated allowlist (no wildcard in production)
CORS_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://saukele_user:saukele_pass@localhost:5432/saukele_db

# ─── Redis (cache + rate limiter + Bull queue backend) ─────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────────
# Both secrets MUST be at least 32 characters. Use different values for each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Nodemailer / SMTP) ─────────────────────────────────────────────
# When EMAIL_DEV_MODE=true, emails are logged to the worker console instead
# of being sent. Leave it on for local dev / defense; turn off for staging.
EMAIL_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Saukele <noreply@saukele.kz>

# ─── Webhooks (HMAC secrets) ───────────────────────────────────────────────
KASPI_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# ─── Optional: external currency API ───────────────────────────────────────
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/KZT
EXCHANGE_RATE_API_KEY=
